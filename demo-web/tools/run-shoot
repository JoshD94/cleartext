#!/usr/bin/env bash
# Headless screenshots of the live demo (queue job). Usage: run-shoot <out-dir> [states|offline]
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
export NODE_PATH=${PW_NODE_PATH:?set PW_NODE_PATH to a node_modules dir with playwright}
node "$here/shoot.mjs" "${DEMO_SITE:-https://cleartext-ai2.pages.dev}" "$1" "${2:-states}" 2>&1 | tee "$1.log"
